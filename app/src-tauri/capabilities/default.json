{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the window may do. Sidecars are named explicitly; nothing else may be executed.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "shell:allow-execute",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "binaries/umbra_ai", "sidecar": true, "args": true },
        { "name": "binaries/umbra_sync", "sidecar": true, "args": true }
      ]
    }
  ]
}
